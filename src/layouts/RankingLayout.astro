---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono&display=swap"
      rel="stylesheet"
    />
    <!-- Aplica el tema antes de pintar para evitar parpadeo -->
    <script is:inline>
      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (stored === "dark" || (!stored && prefersDark)) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body class="min-h-screen bg-canvas font-body text-primary antialiased">
    <div class="mx-auto w-full max-w-[1200px] px-4 py-6 sm:px-6 lg:py-10">
      <!-- Header: logo + título en una línea (apilado en móvil) -->
      <header
        class="mb-5 rounded-3xl border border-default bg-surface px-5 py-5 shadow-sm sm:px-8 sm:py-6"
      >
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6 lg:gap-8">
          <!-- En móvil: logo + toggle en una fila; en web el wrapper se disuelve (sm:contents) -->
          <div class="flex items-center justify-between gap-4 sm:contents">
            <a
              href="/"
              class="block w-40 shrink-0 sm:w-2/5 sm:max-w-none"
              aria-label="FIRST Global Bolivia"
            >
              <img
                src="/Logo-FG-H-light.webp"
                alt="FIRST Global Bolivia"
                class="block h-auto w-full dark:hidden"
                width="1000"
                height="400"
              />
              <img
                src="/Logo-FG-H-dark.webp"
                alt="FIRST Global Bolivia"
                class="hidden h-auto w-full dark:block"
                width="1000"
                height="400"
              />
            </a>

            <!-- Toggle solo en móvil (en web va junto a las pestañas) -->
            <div class="theme-toggle inline-flex shrink-0 items-center gap-1 rounded-full border border-default bg-subtle p-1 sm:hidden">
              <button
                type="button"
                data-theme-set="light"
                aria-label="Tema claro"
                class="flex h-7 w-7 items-center justify-center rounded-full bg-surface text-primary shadow-sm transition-colors dark:bg-transparent dark:text-tertiary dark:shadow-none"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="4"></circle>
                  <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
                </svg>
              </button>
              <button
                type="button"
                data-theme-set="dark"
                aria-label="Tema oscuro"
                class="flex h-7 w-7 items-center justify-center rounded-full text-tertiary transition-colors dark:bg-muted dark:text-primary dark:shadow-sm"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
              </button>
            </div>
          </div>

          <div class="min-w-0 flex-1">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-secondary">
              Torneo Nacional de Robótica
            </p>
            <h1 class="mt-1 font-heading text-3xl leading-none tracking-wide sm:text-4xl lg:text-5xl">
              {title}
            </h1>
          </div>
        </div>
      </header>

      <!-- Tabs + acciones (tema / estado) -->
      <nav
        class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4"
      >
        <div class="flex flex-wrap items-center justify-center gap-2 sm:justify-start">
          {
            tabs.map((t) => (
              <a
                href={t.href}
                class:list={[
                  "rounded-full px-5 py-2.5 text-sm font-bold uppercase tracking-wide transition-colors",
                  t.id === active
                    ? "bg-brand text-inverse shadow-sm"
                    : "bg-surface text-secondary hover:bg-subtle border border-default",
                ]}
              >
                {t.label}
              </a>
            ))
          }
        </div>

        <!-- Toggle solo en web (en móvil va junto al logo) -->
        <div class="hidden items-center justify-center sm:flex">
          <div class="theme-toggle inline-flex shrink-0 items-center gap-1 rounded-full border border-default bg-subtle p-1">
            <button
              type="button"
              data-theme-set="light"
              aria-label="Tema claro"
              class="flex h-7 w-7 items-center justify-center rounded-full bg-surface text-primary shadow-sm transition-colors dark:bg-transparent dark:text-tertiary dark:shadow-none"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
              </svg>
            </button>
            <button
              type="button"
              data-theme-set="dark"
              aria-label="Tema oscuro"
              class="flex h-7 w-7 items-center justify-center rounded-full text-tertiary transition-colors dark:bg-muted dark:text-primary dark:shadow-sm"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
            </button>
          </div>
        </div>
      </nav>

      <!-- Content -->
      <main
        class="rounded-3xl border border-default bg-surface px-4 py-8 shadow-sm sm:px-8 sm:py-10"
      >
        <slot />
      </main>

      <!-- Footer -->
      <footer
        class="mt-2 rounded-3xl border border-default bg-surface px-5 py-6 shadow-sm sm:px-8"
      >
        <div class="flex flex-col items-center gap-5 sm:flex-row sm:justify-between">
          <a href="/" class="block w-32 shrink-0" aria-label="FIRST Global Bolivia">
            <img
              src="/Logo-FG-H-light.webp"
              alt="FIRST Global Bolivia"
              class="block h-auto w-full dark:hidden"
              width="1000"
              height="400"
            />
            <img
              src="/Logo-FG-H-dark.webp"
              alt="FIRST Global Bolivia"
              class="hidden h-auto w-full dark:block"
              width="1000"
              height="400"
            />
          </a>

          <div class="flex items-center gap-2 sm:gap-3">
            {
              socialLinks.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-default text-secondary transition-colors hover:bg-subtle hover:text-primary"
                >
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={social.path}></path>
                  </svg>
                </a>
              ))
            }
          </div>
        </div>

        
      </footer>
    </div>

    <script is:inline>
      document.querySelectorAll("[data-theme-set]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const theme = btn.getAttribute("data-theme-set");
          document.documentElement.classList.toggle("dark", theme === "dark");
          localStorage.setItem("theme", theme);
        });
      });
    </script>
  </body>
</html>
