---
import "../styles/global.css";

interface Props {
  active: "global" | "ingenieria" | "programacion" | "comunicacion";
  title?: string;
}
const { active, title = "Rumbo al FIRST Global Challenge 2026" } = Astro.props;

const tabs = [
  { id: "global", label: "Global Ranking", href: "/" },
  { id: "ingenieria", label: "Ingeniería", href: "/ingenieria" },
  { id: "programacion", label: "Programación", href: "/programacion" },
  { id: "comunicacion", label: "Comunicación", href: "/comunicacion" },
] as const;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-canvas font-body text-primary antialiased">
    <div class="mx-auto w-full max-w-[1200px] px-4 py-6 sm:px-6 lg:py-10">
      <!-- Header -->
      <header
        class="mb-5 rounded-3xl border border-default bg-surface px-5 py-5 shadow-sm sm:px-8 sm:py-6"
      >
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
          <span
            class="inline-flex w-fit items-center rounded-full bg-brand px-4 py-2 text-xs font-bold uppercase tracking-wider text-inverse"
          >
            FIRST Global Bolivia
          </span>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-secondary">
              Torneo Nacional de Robótica · FIRST Global Bolivia
            </p>
            <h1 class="font-heading text-4xl leading-none tracking-wide sm:text-5xl">
              {title}
            </h1>
          </div>
          <div class="sm:ml-auto">
            <span
              id="live-status"
              class="inline-flex items-center gap-2 rounded-full bg-subtle px-3 py-1.5 text-xs font-semibold text-secondary"
            >
              <span id="live-dot" class="h-2 w-2 rounded-full bg-tertiary"></span>
              En vivo
            </span>
          </div>
        </div>
      </header>

      <!-- Tabs -->
      <nav class="mb-5 flex flex-wrap items-center justify-center gap-2">
        {
          tabs.map((t) => (
            <a
              href={t.href}
              class:list={[
                "rounded-full px-5 py-2.5 text-sm font-bold uppercase tracking-wide transition-colors",
                t.id === active
                  ? "bg-brand text-inverse shadow-sm"
                  : "bg-surface text-secondary hover:bg-subtle border border-default",
              ]}
            >
              {t.label}
            </a>
          ))
        }
      </nav>

      <!-- Content -->
      <main
        class="rounded-3xl border border-default bg-surface px-4 py-8 shadow-sm sm:px-8 sm:py-10"
      >
        <slot />
      </main>

      <footer class="mt-4 text-center text-xs text-tertiary">
        Datos en vivo desde Google Sheets · actualiza automáticamente
      </footer>
    </div>
  </body>
</html>
