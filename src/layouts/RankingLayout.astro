---
import "../styles/global.css";

interface Props {
  active: "global" | "ingenieria" | "programacion" | "comunicacion";
  title?: string;
}
const { active, title = "Rumbo al FIRST Global Challenge 2026" } = Astro.props;

const tabs = [
  { id: "global", label: "Global Ranking", href: "/" },
  { id: "ingenieria", label: "Ingeniería", href: "/ingenieria" },
  { id: "programacion", label: "Programación", href: "/programacion" },
  { id: "comunicacion", label: "Comunicación", href: "/comunicacion" },
] as const;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono&display=swap"
      rel="stylesheet"
    />
    <!-- Aplica el tema antes de pintar para evitar parpadeo... -->
    <script is:inline>
      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (stored === "dark" || (!stored && prefersDark)) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body class="min-h-screen bg-canvas font-body text-primary antialiased">
    <div class="mx-auto w-full max-w-[1200px] px-4 py-6 sm:px-6 lg:py-10">
      <!-- Header: logo + título en una línea (apilado en móvil) -->
      <header
        class="mb-5 rounded-3xl border border-default bg-surface px-5 py-5 shadow-sm sm:px-8 sm:py-6"
      >
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6 lg:gap-8">
          <!-- En móvil: logo + toggle en una fila; en web el wrapper se disuelve (sm:contents) -->
          <div class="flex items-center justify-between gap-4 sm:contents">
            <a
              href="/"
              class="block w-40 shrink-0 sm:w-2/5 sm:max-w-none"
              aria-label="FIRST Global Bolivia"
            >
              <img
                src="/Logo-FG-H-light.webp"
                alt="FIRST Global Bolivia"
                class="block h-auto w-full dark:hidden"
                width="1000"
                height="400"
              />
              <img
                src="/Logo-FG-H-dark.webp"
                alt="FIRST Global Bolivia"
                class="hidden h-auto w-full dark:block"
                width="1000"
                height="400"
              />
            </a>

            <!-- Toggle solo en móvil (en web va junto a las pestañas) -->
            <div class="theme-toggle inline-flex shrink-0 items-center gap-1 rounded-full border border-default bg-subtle p-1 sm:hidden">
              <button
                type="button"
                data-theme-set="light"
                aria-label="Tema claro"
                class="flex h-7 w-7 items-center justify-center rounded-full bg-surface text-primary shadow-sm transition-colors dark:bg-transparent dark:text-tertiary dark:shadow-none"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="4"></circle>
                  <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
                </svg>
              </button>
              <button
                type="button"
                data-theme-set="dark"
                aria-label="Tema oscuro"
                class="flex h-7 w-7 items-center justify-center rounded-full text-tertiary transition-colors dark:bg-muted dark:text-primary dark:shadow-sm"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
              </button>
            </div>
          </div>

          <div class="min-w-0 flex-1">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-secondary">
              Torneo Nacional de Robótica
            </p>
            <h1 class="mt-1 font-heading text-3xl leading-none tracking-wide sm:text-4xl lg:text-5xl">
              {title}
            </h1>
          </div>
        </div>
      </header>

      <!-- Tabs + acciones (tema / estado) -->
      <nav
        class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4"
      >
        <div class="flex flex-wrap items-center justify-center gap-2 sm:justify-start">
          {
            tabs.map((t) => (
              <a
                href={t.href}
                class:list={[
                  "rounded-full px-5 py-2.5 text-sm font-bold uppercase tracking-wide transition-colors",
                  t.id === active
                    ? "bg-brand text-inverse shadow-sm"
                    : "bg-surface text-secondary hover:bg-subtle border border-default",
                ]}
              >
                {t.label}
              </a>
            ))
          }
        </div>

        <!-- Toggle solo en web (en móvil va junto al logo) -->
        <div class="hidden items-center justify-center sm:flex">
          <div class="theme-toggle inline-flex shrink-0 items-center gap-1 rounded-full border border-default bg-subtle p-1">
            <button
              type="button"
              data-theme-set="light"
              aria-label="Tema claro"
              class="flex h-7 w-7 items-center justify-center rounded-full bg-surface text-primary shadow-sm transition-colors dark:bg-transparent dark:text-tertiary dark:shadow-none"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
              </svg>
            </button>
            <button
              type="button"
              data-theme-set="dark"
              aria-label="Tema oscuro"
              class="flex h-7 w-7 items-center justify-center rounded-full text-tertiary transition-colors dark:bg-muted dark:text-primary dark:shadow-sm"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
            </button>
          </div>
        </div>
      </nav>

      <!-- Content -->
      <main
        class="rounded-3xl border border-default bg-surface px-4 py-8 shadow-sm sm:px-8 sm:py-10"
      >
        <slot />
      </main>

      <!-- Footer -->
      <footer
        class="mt-6 rounded-3xl border border-default bg-surface px-5 py-6 shadow-sm sm:px-8"
      >
        <div class="flex flex-col items-center gap-5 sm:flex-row sm:justify-between">
          <a href="/" class="block w-32 shrink-0" aria-label="FIRST Global Bolivia">
            <img
              src="/Logo-FG-H-light.webp"
              alt="FIRST Global Bolivia"
              class="block h-auto w-full dark:hidden"
              width="1000"
              height="400"
            />
            <img
              src="/Logo-FG-H-dark.webp"
              alt="FIRST Global Bolivia"
              class="hidden h-auto w-full dark:block"
              width="1000"
              height="400"
            />
          </a>

          <div class="flex items-center gap-2 sm:gap-3">
            <a
              href="#"
              aria-label="Instagram"
              class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-default text-secondary transition-colors hover:bg-subtle hover:text-primary"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.76 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path>
              </svg>
            </a>
            <a
              href="#"
              aria-label="Facebook"
              class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-default text-secondary transition-colors hover:bg-subtle hover:text-primary"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
              </svg>
            </a>
            <a
              href="#"
              aria-label="TikTok"
              class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-default text-secondary transition-colors hover:bg-subtle hover:text-primary"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path>
              </svg>
            </a>
            <a
              href="#"
              aria-label="YouTube"
              class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-default text-secondary transition-colors hover:bg-subtle hover:text-primary"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
              </svg>
            </a>
          </div>
        </div>

        <div
          class="mt-5 border-t border-default pt-4 text-center text-xs text-tertiary"
        >
          Rumbo al FIRST Global Challenge 2026
        </div>
      </footer>
    </div>

    <script is:inline>
      document.querySelectorAll("[data-theme-set]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const theme = btn.getAttribute("data-theme-set");
          document.documentElement.classList.toggle("dark", theme === "dark");
          localStorage.setItem("theme", theme);
        });
      });
    </script>
  </body>
</html>
