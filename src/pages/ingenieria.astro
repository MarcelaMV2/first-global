---
import RankingLayout from "../layouts/RankingLayout.astro";
---

<RankingLayout active="ingenieria">
  <div id="view" class="min-h-[40vh]"></div>
</RankingLayout>

<script>
  import { startPolling } from "../scripts/poll";
  import { renderIngenieria } from "../scripts/views/ingenieria";
  const view = document.getElementById("view")!;
  startPolling((data) => renderIngenieria(view, data));
</script>
